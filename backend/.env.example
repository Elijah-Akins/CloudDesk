# Server Configuration
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/clouddesk

# JWT Configuration - each secret must be at least 32 characters
# Generate each with: openssl rand -hex 32
JWT_ACCESS_SECRET=your-256-bit-access-secret-key-here
JWT_REFRESH_SECRET=your-256-bit-refresh-secret-key-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption Key for SSH Credentials - REQUIRED, exactly 64 hex characters (32 bytes)
# The server refuses to start until this is set. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# SSH Tunnel Port Range
TUNNEL_PORT_RANGE_START=6000
TUNNEL_PORT_RANGE_END=7000

# WebSocket Port Range for VNC Proxy
WEBSOCKET_PORT_RANGE_START=6080
WEBSOCKET_PORT_RANGE_END=6180

# Session Configuration
SESSION_TIMEOUT_MINUTES=30

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS - Comma-separated list of allowed origins
# For development:
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# For production:
# CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Logging
LOG_LEVEL=debug
